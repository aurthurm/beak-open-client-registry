{
  "name": "client-registry",
  "version": "1.0.0",
  "description": "Client Registry",
  "main": "src/app.ts",
  "scripts": {
    "start": "node --import tsx src/app.ts",
    "dev": "env NODE_ENV=development node --import tsx src/app.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "env NODE_ENV=test jest --testPathIgnorePatterns=__tests__/e2e",
    "e2e": "env NODE_ENV=test node --import tsx __tests__/e2e/resetTestData.ts && jest --detectOpenHandles --testPathPattern=__tests__/e2e"
  },
  "keywords": [
    "client registry",
    "master patient index"
  ],
  "author": "Intrahealth International",
  "license": "ISC",
  "dependencies": {
    "acorn": ">=8.16.0",
    "async": "^3.2.6",
    "axios": "^1.16.0",
    "body-parser": "^2.2.2",
    "damerau-levenshtein": "^1.0.8",
    "double-metaphone": "^2.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-levenshtein": "^3.0.0",
    "fhir": "^4.12.0",
    "fhirpath": "^4.10.0",
    "formidable": "^3.5.4",
    "is-json": "^2.0.1",
    "jaro-winkler": "^0.2.8",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": ">=4.18.1",
    "metaphone": "^2.0.1",
    "minimist": ">=1.2.8",
    "moment": "^2.30.1",
    "nanoid": "^5.1.11",
    "nconf": "^0.13.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "openhim-mediator-utils": "^0.4.0",
    "qs": "^6.15.1",
    "redis": "^5.12.1",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "slashes": "^3.0.12",
    "soundex-code": "^2.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "underscore": "^1.13.8",
    "urijs": "^1.19.11",
    "uuid": "^14.0.0",
    "uuid4": "^2.0.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.25",
    "@types/body-parser": "^1.19.6",
